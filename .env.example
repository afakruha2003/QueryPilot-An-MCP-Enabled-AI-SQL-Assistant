# Local development only. Replace values before starting services.
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Local application database used by the API. Retail data must use a separate
# read-only database role and an approved technical configuration.
DATABASE_URL=postgresql://querypilot:local-dev-only@localhost:5432/querypilot

# Provider credentials belong on the server only; never add them to frontend/.
# LLM_PROVIDER=
# LLM_API_KEY=
